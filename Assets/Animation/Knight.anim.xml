<?xml version="1.0" encoding="utf-8"?>
<!--
	Knight 스프라이트 애니메이션.

	★ 이 파일은 생성물이다 ★
	손으로 고치지 말고 원본을 고친 뒤 다시 뽑을 것.
	    원본   : Assets/Knight_sprite.txt
	    변환기 : Tools/convert_anim.py

	Clip name   : 상태 머신의 State가 지목하는 "논리" 이름.
	Clip facing : 이 그림이 그려진 시점. Up / Right / Down / Left / Side.
	              같은 name을 facing만 다르게 여러 번 쓰면 하나의 방향 세트가 된다.
	              빠진 방향은 엔진이 로드 시점에 폴백으로 채운다
	              (규칙은 Asset/SpriteAnimationLoader.h 주석 참고).
	pivot       : 액터 위치에 놓일 스프라이트 안의 점. 방향마다 하나이고 x는 정수다 -
	              클립마다 다르면 상태가 바뀔 때 캐릭터가 옆으로 튀고,
	              반쪽 값은 좌우 반전에서 한 칸 튄다.

	기호는 SymbolPalette(Math/SymbolPalette.h)의 16개 대문자 + 투명('.')만 쓸 수 있다.

	이 파일은 UTF-8(BOM 없이)로 저장할 것.
-->
<SpriteAnimation>

	<!-- 앞모습 대기 -->
	<Clip name="Idle" facing="Down" fps="3" loop="true" width="8" height="8" pivot="2,3.5">
		<Frame>
			LLLLL.L.
			BBBBB.L.
			BKKKB.L.
			BBKBB.L.
			DDLLDDB.
			DDBKK...
			DDDDD...
			K...K...
		</Frame>
	</Clip>

	<!-- 뒷모습 대기 -->
	<Clip name="Idle" facing="Up" fps="3" loop="true" width="8" height="8" pivot="4,3.5">
		<Frame>
			L.LLLLL.
			L.LLLLL.
			L.LLLLL.
			L.LLLLL.
			BDDLLLD.
			..KKKKKD
			..DDDDD.
			..K...K.
		</Frame>
	</Clip>

	<!-- 앞모습 이동 -->
	<Clip name="Walk" facing="Down" fps="8" loop="true" width="8" height="8" pivot="2,3.5">
		<Frame>
			LLLLLL..
			BBBBBL..
			BKKKBL..
			BBKBBL..
			DDDLDB..
			DDDKK...
			DDDDD...
			.K......
		</Frame>
		<Frame>
			LLLLL...
			BBBBB.L.
			BKKKB.L.
			BBKBB.L.
			DDLLD.L.
			DDBKKDB.
			DDDDD...
			...K....
		</Frame>
	</Clip>

	<!-- 측면 이동 -->
	<Clip name="Walk" facing="Side" fps="8" loop="true" width="8" height="8" pivot="2,3.5">
		<Frame>
			LLLLL.L.
			LBBBB.L.
			LBKKK.L.
			LBBKB.L.
			DDLLDDB.
			DDKBK...
			DDDDD...
			K...K...
		</Frame>
		<Frame>
			LLLLLL..
			LBBBBL..
			LBKKKL..
			LBBKBL..
			DDDLDB..
			DDDBK...
			DDDDD...
			.KKK....
		</Frame>
	</Clip>

	<!-- 뒷모습 이동 -->
	<Clip name="Walk" facing="Up" fps="8" loop="true" width="8" height="8" pivot="4,3.5">
		<Frame>
			LLLLLL..
			LLLLLL..
			LLLLLL..
			LLLLLL..
			BDLLLD..
			.KKKKK..
			.DDDDD..
			....K...
		</Frame>
		<Frame>
			..LLLLL.
			L.LLLLL.
			L.LLLLL.
			L.LLLLL.
			L.DLLLD.
			BDKKKKKD
			..DDDDD.
			..K.....
		</Frame>
	</Clip>

	<!-- 앞모습 공격 -->
	<Clip name="Attack" facing="Down" fps="12" loop="false" width="8" height="8" pivot="2,3.5">
		<Frame>
			LLLLL.L.
			BBBBB.L.
			BKKKB.L.
			BBKBB.B.
			DDLLDD..
			DDBKK...
			DDDDD...
			K...K...
		</Frame>
		<Frame>
			LLLLL...
			BBBBB...
			BKKKB...
			DDKBB...
			DDLLDD..
			DDBKKKB.
			DDDDDL..
			K...L...
		</Frame>
	</Clip>

	<!-- 측면 공격 -->
	<Clip name="Attack" facing="Side" fps="12" loop="false" width="12" height="8" pivot="2,3.5">
		<Frame>
			LLLLL.......
			LBBBB.......
			LBKKKL......
			LBBKBKB.....
			DDLLDD......
			DDKBK.......
			DDDDD.......
			K....K......
		</Frame>
		<Frame>
			.LLLLL......
			.LBBBB......
			.LBKKK......
			DDDBKB......
			DDDLLDDBLLLL
			DDDKBK......
			DDDDDD......
			K....K......
		</Frame>
	</Clip>

	<!-- 뒷모습 공격 -->
	<Clip name="Attack" facing="Up" fps="12" loop="false" width="8" height="8" pivot="4,3.5">
		<Frame>
			L.LLLLL.
			L.LLLLL.
			L.LLLLL.
			B.LLLLL.
			.DDLLLD.
			..KKKKKD
			..DDDDD.
			..K...K.
		</Frame>
		<Frame>
			.LLLLL..
			.LLLLL..
			.LLLLL..
			.LLLLL..
			.DLLLDD.
			BKKKKK..
			LDDDDD..
			LK...K..
		</Frame>
	</Clip>

	<Clip name="Rolling" fps="20" loop="false" width="13" height="8" pivot="4,3.5">
		<!-- 구르기가 실제로 끝나는 순간을 게임플레이에게 알린다.
		     이게 없으면 IsRolling이 계속 참으로 남아서 Any->Roll이 매번 다시 잡아채
		     구르기 상태를 영영 못 빠져나온다. -->
		<Notify frame="end" name="RollEnd" />
		<Frame>
			.DDDDD.D.....
			.DLLLL.D.....
			.DLKKK.D.....
			.DLLKL.D.....
			KKKLLDDB.....
			KKKKDK.D.....
			KKKDDD.......
			.............
		</Frame>
		<Frame>
			...DDDD......
			..KLDDDDK....
			.KDLLLDDDK...
			.KDLLLDDDK...
			..KKDDDKK....
			....KKK......
			.L........L..
			.DL......LD..
		</Frame>
		<Frame>
			.............
			...KKDD......
			..KLLLLDD....
			.KDLLLDDDK...
			.KKDDDDDKD...
			..KKDDDKK....
			....KKK......
			.............
		</Frame>
		<Frame>
			...KKKK......
			..KDDLLDD....
			.KDDDDLLDD...
			.KDDDDLLDD...
			..KKDDLKK....
			....KKK......
			.L........L..
			.DL......LD..
		</Frame>
		<Frame>
			.............
			...KDKK......
			..KDDDLK.....
			.KDDDDDDKK...
			.KDDDLLLDK...
			..KKLLLDD....
			....KKD......
			.............
		</Frame>
		<Frame>
			.............
			...KKKK......
			..KDDDDKD....
			.KLLDDDDDK...
			.DDLLLDDDK...
			..DDLLDKK....
			....DDK......
			.............
		</Frame>
		<Frame>
			.DDDDD....DD.
			.DLLLL...DD..
			.DLKKK..DD...
			.DLLKL.DD....
			KKKLLDBD.....
			KKKKDK.......
			KKKDDD.......
			.............
		</Frame>
	</Clip>

	<!-- 피격 · Down -->
	<Clip name="Hit" facing="Down" fps="14" loop="false" width="8" height="8" pivot="4,3.5">
		<Notify frame="end" name="HitEnd" />
		<Frame>
			BBBBB.B.
			BBBBB.B.
			BBBBB.B.
			BBBBB.B.
			BBBBBBB.
			BBBBB...
			BBBBB...
			B...B...
		</Frame>
		<Frame>
			........
			LLLLL.L.
			DDDDD.L.
			DKKKD.L.
			DDKDD.B.
			DDLLDD..
			DDBKK...
			K.DDD.K.
		</Frame>
	</Clip>

	<!-- 피격 · Up -->
	<Clip name="Hit" facing="Up" fps="14" loop="false" width="8" height="8" pivot="4,3.5">
		<Notify frame="end" name="HitEnd" />
		<Frame>
			B.BBBBB.
			B.BBBBB.
			B.BBBBB.
			B.BBBBB.
			BBBBBBB.
			..BBBBBB
			..BBBBB.
			..B...B.
		</Frame>
		<Frame>
			........
			L.LLLLL.
			L.DDDDD.
			L.DDDDD.
			BDDLLLD.
			..KKKKKD
			..DDDDD.
			.K.....K
		</Frame>
	</Clip>
	
	<!-- 피격 · Side -->
	<Clip name="Hit" facing="Side" fps="14" loop="false" width="8" height="8" pivot="4,4.5">
		<Notify frame="end" name="HitEnd" />
		<Frame>
			BBBBB.B.
			BBBBB.B.
			BBBBB.B.
			BBBBB.B.
			BBBBBBB.
			BBBBB...
			BBBBB...
			B...B...
		</Frame>
		<Frame>
			........
			.LLLLL.L
			.DBBBB.L
			.DBKKK.L
			.DDLLDDB
			.DDKBK..
			.DDDDD..
			.K...K..
		</Frame>
	</Clip>
	
		<!-- 사망 · Down -->
	<Clip name="Death" facing="Down" fps="8" loop="false" width="8" height="8" pivot="4,4.5">
		<Notify frame="end" name="DeathEnd" />
		<Frame>
			.LLLLL..
			.DDDDD..
			.DKKKD..
			.DDKDD.L
			DDLLDDL.
			DDBKK...
			DDDDD...
			K.....K.
		</Frame>
		<Frame>
			........
			..LLLL..
			..DDDD..
			..DKKD.L
			.DDLLDL.
			.DDDDD..
			DDDDDDD.
			K.....K.
		</Frame>
		<Frame>
			........
			........
			.....L..
			LLLL.L..
			DDDDDL..
			DKKDDD..
			DDDDDDD.
			KDDDDDK.
		</Frame>
		<Frame>
			........
			........
			........
			........
			........
			.LLL....
			LKKLDDL.
			DDDDDDD.
		</Frame>
	</Clip>

	<!-- 사망 · Up -->
	<Clip name="Death" facing="Up" fps="8" loop="false" width="8" height="8" pivot="4,3.5">
		<Notify frame="end" name="DeathEnd" />
		<Frame>
			.LLLLL..
			.LLLLL..
			.LLLLL..
			.DDDDD.L
			BDDLLLDL
			..KKKKK.
			..DDDDD.
			.K.....K
		</Frame>
		<Frame>
			........
			..LLLL..
			..LLLL..
			..DDDD.L
			.DDLLDL.
			..KKKKK.
			.DDDDDD.
			.K.....K
		</Frame>
		<Frame>
			........
			........
			.....L..
			LLLL.L..
			DDDDDL..
			DKKKDD..
			DDDDDDD.
			KDDDDDK.
		</Frame>
		<Frame>
			........
			........
			........
			........
			........
			.LLL....
			LLLLDDL.
			DDDDDDD.
		</Frame>
	</Clip>
</SpriteAnimation>
