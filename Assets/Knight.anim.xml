<?xml version="1.0" encoding="utf-8"?>
<!--
	TestActor 스프라이트 애니메이션.

	Clip  name : PlayClip()에 넘기는 이름. fps : 초당 프레임 수. loop : 반복 여부.
	Frame      : 픽셀맵 한 장. 줄 앞뒤 공백은 무시되므로 들여쓰기를 자유롭게 써도 된다.

	width/height : 선택. 적어두면 픽셀맵과 대조해서 다르면 크래시한다.
	             진실의 원천은 픽셀맵이고 이건 선언일 뿐이다.
	             줄이 통째로 빠져 8x8이 8x7이 되는 실수는 이 선언이 있어야 걸린다.
	pivot        : 선택. "x,y" 형태로 액터 위치에 놓일 스프라이트 안의 점(셀 단위).
	             생략하면 가운데 맨 아래(발밑) = ((width-1)*0.5, height-1).
	             x가 실수인 이유 - 짝수 너비의 가운데는 정수로 안 떨어진다(8칸이면 3.5).
	             정수로 반올림해두면 좌우 반전할 때마다 그림이 한 칸씩 튄다.

	기호는 SymbolPalette(Math/SymbolPalette.h)의 16개 대문자 + 투명('.')만 쓸 수 있다.
	  무채색 K(Black) D(DarkGray) L(Gray) B(White)
	  녹색   F(DarkGreen) G(Green)
	  갈색   N(DarkBrown) W(Brown) T(Tan)
	  적색   C(DarkRed) R(Red)
	  난색   O(Orange) Y(Yellow)
	  청색   V(DarkBlue) U(Blue)
	  보라   P(Purple)

	이 파일은 UTF-8(BOM 없이)로 저장할 것.
-->
<SpriteAnimation>

	<!-- 대기. 상체가 1픽셀 내려앉았다 올라오는 호흡. -->
	<Clip name="Idle" fps="3" loop="true" width="8" height="8" pivot="3.5,7">
		<Frame>
			.DDDDD.D
			.DLLLL.D
			.DLKKK.D
			.DLLKL.D
			KKKLLDDB
			KKKKDK.D
			KKKDDD..
			.K...K..
		</Frame>
		<Frame>
			........
			.DDDDD.D
			.DLLLL.D
			.DLKKK.D
			KKKLLDDB
			KKKKDK.D
			KKKDDD..
			.K...K..
		</Frame>
	</Clip>

	<!-- 걷기. 접지 / 왼발 듦 / 접지 / 오른발 듦 4장 사이클. -->
	<Clip name="Walk" fps="8" loop="true" width="8" height="8" pivot="3.5,7">
		<Frame>
			.DDDDD.D
			.DLLLL.D
			.DLKKK.D
			.DLLKL.D
			KKKLLDDB
			KKKKDK.D
			KKKDDD..
			.K...K..
		</Frame>
		<Frame>
			.DDDDD.D
			.DLLLL.D
			.DLKKK.D
			.DLLKL.D
			KKKLLDDB
			KKKKDK.D
			KKKDDD..
			.....K..
		</Frame>
		<Frame>
			.DDDDD.D
			.DLLLL.D
			.DLKKK.D
			.DLLKL.D
			KKKLLDDB
			KKKKDK.D
			KKKDDD..
			.K...K..
		</Frame>
		<Frame>
			.DDDDD.D
			.DLLLL.D
			.DLKKK.D
			.DLLKL.D
			KKKLLDDB
			KKKKDK.D
			KKKDDD..
			.K......
		</Frame>
	</Clip>
	
	
		<!-- 공격. -->
	<Clip name="Attack" fps="12" loop="false" width="13" height="8" pivot="3.5,7">
		<Frame>
			.DDDDD.D.....
			.DLLLL.D.....
			.DLKKK.D.....
			.DLLKL.D.....
			KKKLLDDB.....
			KKKKDK.D.....
			KKKDDD.......
			.............
		</Frame>
		<Frame>
			.DDDDD.......
			.DLLDD.......
			.DLKKDD......
			.DLLKLBD.....
			KKKLLDDD.....
			KKKKDK.......
			KKKDDD.......
			.............
		</Frame>
		<Frame>
			.DDDDD....DD.
			.DLLLL...DD..
			.DLKKK..DD...
			.DLLKL.DD....
			KKKLLDBD.....
			KKKKDK.......
			KKKDDD.......
			.............
		</Frame>		
		<Frame>
			.DDDDD.B.....
			.DLLLL..BB...
			.DLKKK...BB..
			.DLLKL.....B.
			KKKLLDBDDDDDD
			KKKKDK.......
			KKKDDD.......
			.............
		</Frame>
		<Frame>
			.DDDDD.......
			.DLLLL.......
			.DLKKK.......
			.DLLKL..BB...
			KKKLLDD..BB..
			KKKKDKBDD.BB.
			KKKDDD..DD.BB
			..........DD.
		</Frame>
		<Frame>
			.DDDDD.D.....
			.DLLLL.D.....
			.DLKKK.D.....
			.DLLKL.D.....
			KKKLLDDB.....
			KKKKDK.D.....
			KKKDDD.......
			.............
		</Frame>
	</Clip>
	
		<!-- 구른다...! -->
	<Clip name="Rolling" fps="20" loop="false" width="13" height="8" pivot="3.5,7">
		<!-- 구르기가 실제로 끝나는 순간을 게임플레이에게 알린다.
		     이게 없으면 IsRolling이 계속 참으로 남아서 Any->Roll이 매번 다시 잡아채
		     구르기 상태를 영영 못 빠져나온다. -->
		<Notify frame="end" name="RollEnd" />
		<Frame>
			.DDDDD.D.....
			.DLLLL.D.....
			.DLKKK.D.....
			.DLLKL.D.....
			KKKLLDDB.....
			KKKKDK.D.....
			KKKDDD.......
			.............
		</Frame>
		<Frame>
			...DDDD......
			..KLDDDDK....
			.KDLLLDDDK...
			.KDLLLDDDK...
			..KKDDDKK....
			....KKK......
			.L........L..
			.DL......LD..
		</Frame>
		<Frame>
			.............
			...KKDD......
			..KLLLLDD....
			.KDLLLDDDK...
			.KKDDDDDKD...
			..KKDDDKK....
			....KKK......
			.............
		</Frame>		
		<Frame>
			...KKKK......
			..KDDLLDD....
			.KDDDDLLDD...
			.KDDDDLLDD...
			..KKDDLKK....
			....KKK......
			.L........L..
			.DL......LD..
		</Frame>
		<Frame>
			.............
			...KDKK......
			..KDDDLK.....
			.KDDDDDDKK...
			.KDDDLLLDK...
			..KKLLLDD....
			....KKD......
			.............
		</Frame>
		<Frame>
			.............
			...KKKK......
			..KDDDDKD....
			.KLLDDDDDK...
			.DDLLLDDDK...
			..DDLLDKK....
			....DDK......
			.............
		</Frame>
		<Frame>
			.DDDDD....DD.
			.DLLLL...DD..
			.DLKKK..DD...
			.DLLKL.DD....
			KKKLLDBD.....
			KKKKDK.......
			KKKDDD.......
			.............
		</Frame>
	</Clip>

</SpriteAnimation>
