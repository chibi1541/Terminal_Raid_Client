<?xml version="1.0" encoding="utf-8"?>
<!--
	액터 관련 데이터 파일의 인덱스. (ActorDataAsset - PrimaryAssets.xml 의 type="ActorData")

	LevelData.xml / AnimationData.xml 과 같은 자리다 - 종류별 하위 파일 경로만 들고 있고,
	실제 수치는 각 하위 파일이 정의한다. ActorDataAsset 이 이 파일을 읽고 각 하위 파일을
	해당 타입의 테이블로 파싱한다. 게임은 ActorDataAsset 한 곳에서 전부 가져간다.

	각 항목의 tag 는 ActorDataAsset 이 아는 데이터 종류이고, path 가 그 파일 위치다.
	새 종류를 추가하려면 (1) 여기에 한 줄, (2) 그 타입의 Table 클래스, (3) ActorDataAsset 에 dispatch.

	ProjectileData 는 Server/Config/ProjectileData.xml 에서 sync_projectile_data.py 로 복제된다.
	나머지(PlayerData / MonsterData / PropData)는 아직 미구현 - 아래 주석 슬롯을 열면 된다.

	이 파일 자체는 클라 전용 인덱스라 동기화 대상이 아니다. 손으로 관리한다.
	경로는 Config/ 와 같은 관습대로 프로젝트 폴더 기준 상대 경로다. BOM 없는 UTF-8.
-->
<ActorData>
	<ProjectileData path="../Assets/Actor/ProjectileData.xml" />

	<!-- 나중에 추가:
	<PlayerData  path="../Assets/Actor/PlayerData.xml" />
	<MonsterData path="../Assets/Actor/MonsterData.xml" />
	<PropData    path="../Assets/Actor/PropData.xml" />
	-->
</ActorData>
